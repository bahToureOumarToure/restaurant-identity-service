<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ===================================================================
         PARENT : on hérite de Spring Boot pour avoir toutes les versions
         de dépendances déjà testées et compatibles entre elles (BOM).
         Avantage : on n'écrit jamais "<version>x.y.z</version>" pour les
         libs Spring, c'est géré automatiquement.
         =================================================================== -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version>
        <relativePath/>
    </parent>

    <!-- ===================================================================
         IDENTITÉ DU PROJET (coordonnées Maven uniques)
         groupId  = identifiant de l'organisation (ex: com.google)
         artifactId = nom du projet (ex: guava)
         version  = version courante (-SNAPSHOT = en développement)
         =================================================================== -->
    <groupId>com.restaurant</groupId>
    <artifactId>api-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>identity-service</name>
    <description>Service d'authentification et de gestion des utilisateurs</description>

    <!-- ===================================================================
         PROPRIÉTÉS : variables réutilisables dans le pom
         =================================================================== -->
    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jjwt.version>0.12.6</jjwt.version>
        <testcontainers.version>1.20.4</testcontainers.version>
    </properties>

    <!-- ===================================================================
         DÉPENDANCES : c'est le cœur du fichier
         =================================================================== -->
    <dependencies>

        <!-- ===== STARTERS SPRING BOOT (cœur du framework) ===== -->

        <!-- Spring Web : pour exposer des endpoints REST (@RestController) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Security : sécurise les endpoints (filtres, authentification) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Spring Data JPA : ORM pour communiquer avec la DB -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Validation : annotations @NotBlank, @Email, @Valid... -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Actuator : endpoints de santé /actuator/health, /actuator/info -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ===== BASE DE DONNÉES ===== -->

        <!-- Driver JDBC PostgreSQL : pour se connecter à Postgres -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway : migrations DB versionnées (V1__..., V2__...) -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- ===== JWT (signature RS256) ===== -->
        <!-- Bibliothèque jjwt = "Java JWT" de jsonwebtoken.io -->
        <!-- 3 modules : api (interfaces), impl (implémentation), jackson (sérialisation JSON) -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== LOMBOK (réduit le boilerplate) ===== -->
        <!-- Génère getters/setters/constructeurs via annotations @Data, @Builder... -->
        <!-- scope=provided car les annotations disparaissent à la compilation -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ===== TESTS ===== -->

        <!-- Spring Boot Test : JUnit 5 + Mockito + AssertJ + Spring Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Security Test : helpers @WithMockUser, etc. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers : démarre une vraie DB Postgres éphémère pour les tests -->
        <!-- Beaucoup mieux qu'un H2 in-memory qui ment sur le comportement Postgres -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ===================================================================
         BUILD : plugins qui orchestrent la compilation et le packaging
         =================================================================== -->
    <build>
        <plugins>

            <!-- Compilateur Java avec support Lombok -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Plugin Spring Boot : crée un JAR exécutable autonome -->
            <!-- Permet de faire "java -jar identity-service.jar" -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>